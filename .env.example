# -----------------------------------------------------------------------------
# CollabFlow Environment Configuration
# -----------------------------------------------------------------------------

# Environment & Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection string, or leave empty in development for auto memory server)
MONGODB_URI=mongodb://127.0.0.1:27017/collabflow

# JWT Secrets & Configuration
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters_long_for_security
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters_long_for_security
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Admin Bootstrap Configuration (for running npm run bootstrap:admin)
ADMIN_BOOTSTRAP_NAME=Global Admin
ADMIN_BOOTSTRAP_EMAIL=admin@collabflow.dev
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeNow123!

# Email Service (Optional for development; reset tokens will be logged to console if disabled)
EMAIL_ENABLED=false
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_email_user
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=CollabFlow <no-reply@collabflow.dev>

# File Storage (local or s3)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
